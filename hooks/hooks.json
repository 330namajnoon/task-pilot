{
  "description": "task-pilot: session context, activity heartbeats for time tracking, session-to-task binding and the /task-pilot:tasks panel",
  "modules": ["./panel/register.tsx"],
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bundle/hook.js\"", "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bundle/hook.js\"", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bundle/hook.js\"", "timeout": 10 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bundle/hook.js\"", "timeout": 10 }] }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*task-pilot.*__task_(create|start|resume|stop)",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bundle/hook.js\"", "timeout": 10 }]
      }
    ]
  }
}
